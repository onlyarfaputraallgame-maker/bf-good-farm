-- ══════════════════════════════════════════
--  MAIN LOOP
-- ══════════════════════════════════════════
local loopTick = 0
task.spawn(function()
    while true do
        task.wait(0.15)
        if not CFG.AutoFarm then
            DisableFly()
            continue
        end
        if not IsAlive() then task.wait(2) continue end
        if GetHP() < CFG.SafeHP then
            DisableFly()
            task.wait(2)
            continue
        end

        loopTick = loopTick + 1

        local mobs = GetMobs()
        if #mobs == 0 then
            DisableFly()
            task.wait(1)
            continue
        end

        local target = mobs[1]
        if not target or target.hum.Health <= 0 then continue end

        -- fly to position ABOVE mob head
        local hoverPos = Vector3.new(
            target.root.Position.X,
            target.root.Position.Y + CFG.HoverHeight,
            target.root.Position.Z
        )

        FlyTo(hoverPos)
        if not IsAlive() then continue end
        if target.hum.Health <= 0 then continue end

        -- attack while hovering above
        local kt = 0
        while target.hum.Health > 0 and kt < 10 and IsAlive() do
            -- keep hovering above target as it moves
            if bodyPos and target.root then
                bodyPos.Position = Vector3.new(
                    target.root.Position.X,
                    target.root.Position.Y + CFG.HoverHeight,
                    target.root.Position.Z
                )
            end
            M1()
            Skills()
            task.wait(0.2)
            kt = kt + 0.2
        end
    end
end)

