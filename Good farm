-- ══════════════════════════════════════════
--  MAIN LOOP
-- ══════════════════════════════════════════
local loopTick = 0
task.spawn(function()
    while true do
        task.wait(0.15)
        if not CFG.AutoFarm then continue end
        if not IsAlive() then task.wait(2) continue end
        if GetHP() < CFG.SafeHP then task.wait(2) continue end

        loopTick = loopTick + 1
        if CFG.AutoQuest and loopTick % 60 == 0 then
            pcall(TryQuest)
        end

        local mobs = GetMobs()
        if #mobs == 0 then task.wait(1) continue end

        local target = mobs[1]
        if not target or target.hum.Health <= 0 then continue end

        WalkTo(target.root.Position)
        if not IsAlive() then continue end
        if target.hum.Health <= 0 then continue end

        local kt = 0
        while target.hum.Health > 0 and kt < 10 and IsAlive() do
            M1()
            Skills()
            task.wait(0.2)
            kt = kt + 0.2
        end
    end
end)

