local function Skills()
    local keys = {
        Enum.KeyCode.Z, Enum.KeyCode.X,
        Enum.KeyCode.C, Enum.KeyCode.V, Enum.KeyCode.F
    }
    for _, k in ipairs(keys) do
        pcall(function() VIM:SendKeyEvent(true, k, false, game) end)
        task.wait(0.05)
        pcall(function() VIM:SendKeyEvent(false, k, false, game) end)
        task.wait(0.05)
    end
end

-- ══════════════════════════════════════════
--  AUTO QUEST — clicks Accept button in dialog
-- ══════════════════════════════════════════
local function ClickAcceptButton()
    -- search all GUIs for the Accept button BF uses
    for _, gui in ipairs(lp.PlayerGui:GetDescendants()) do
        if gui:IsA("TextButton") or gui:IsA("TextLabel") then
            local t = string.lower(gui.Text or "")
            if t == "accept" or t == "accept quest" then
                -- fire a click on it
                pcall(function()
                    local vClick = Instance.new("InputObject")
                    vClick.UserInputType = Enum.UserInputType.MouseButton1
                    gui:SimulateClick()
                end)
                -- fallback: fire the remote directly
                pcall(function()
                    local remotes = {"TakeQuest","QuestStart","Quest","GiveQuest"}
                    for _, name in ipairs(remotes) do
                        local rem = RS:FindFirstChild(name, true)
                        if rem and rem:IsA("RemoteEvent") then
                            rem:FireServer("Accept")
                            rem:FireServer(1)
                            rem:FireServer(true)
                        end
                    end
                end)
            end
        end
    end
end

local function FindQuestNPC()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local low = string.lower(obj.Name)
            if string.find(low,"quest") or string.find(low,"marine") or string.find(low,"military") then
                local qr = obj:FindFirstChild("HumanoidRootPart")
                if qr then return qr end
            end
        end
    end
    return nil
end

local function TryQuest()
    -- click any open Accept button first
    ClickAcceptButton()
    task.wait(0.3)

    -- walk to quest NPC if no dialog open
    local npc = FindQuestNPC()
    if npc and GetHRP() then
        if (GetHRP().Position - npc.Position).Magnitude > 15 then
            WalkTo(npc.Position)
            task.wait(0.5)
        end
        ClickAcceptButton()
    end
end

