-- ══════════════════════════════════════════
local function ClickAccept()
    for _, gui in ipairs(lp.PlayerGui:GetDescendants()) do
        if (gui:IsA("TextButton") or gui:IsA("TextLabel")) then
            local t = string.lower(tostring(gui.Text))
            if t == "accept" or t == "accept quest" then
                pcall(function() gui:SimulateClick() end)
                pcall(function()
                    local names = {"TakeQuest","QuestStart","Quest","GiveQuest"}
                    for _, name in ipairs(names) do
                        local rem = RS:FindFirstChild(name, true)
                        if rem and rem:IsA("RemoteEvent") then
                            rem:FireServer("Accept")
                        end
                    end
                end)
            end
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.5)
        if CFG.AutoQuest then pcall(ClickAccept) end
    end
end)

