local CFG = {
    AutoFarm    = false,
    AutoQuest   = false,
    AutoHaki    = false,
    ScanRadius  = 2000,
    SafeHP      = 0.25,
    HoverHeight = 5, -- studs above mob HumanoidRootPart
}

local function GetChar() return lp.Character end
local function GetHRP()
    local c = GetChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function GetHum()
    local c = GetChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function GetHP()
    local h = GetHum()
    if h then return h.Health / math.max(h.MaxHealth, 1) end
    return 1
end
local function IsAlive()
    local h = GetHum()
    return h and h.Health > 0
end

-- ══════════════════════════════════════════
--  FLY SETUP — bypass gravity to hover
-- ══════════════════════════════════════════
local bodyPos, bodyGy

local function EnableFly()
    local hrp = GetHRP()
    if not hrp then return end
    if hrp:FindFirstChild("ollieBP") then return end

    local bp = Instance.new("BodyPosition")
    bp.Name      = "ollieBP"
    bp.MaxForce  = Vector3.new(1e5, 1e5, 1e5)
    bp.P         = 1e4
    bp.D         = 1e3
    bp.Position  = hrp.Position
    bp.Parent    = hrp

    local bg = Instance.new("BodyGyro")
    bg.Name     = "ollieBG"
    bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bg.P        = 1e4
    bg.D        = 1e3
    bg.CFrame   = hrp.CFrame
    bg.Parent   = hrp

    bodyPos = bp
    bodyGy  = bg
end

local function DisableFly()
    local hrp = GetHRP()
    if not hrp then return end
    local bp = hrp:FindFirstChild("ollieBP")
    local bg = hrp:FindFirstChild("ollieBG")
    if bp then bp:Destroy() end
    if bg then bg:Destroy() end
    bodyPos = nil
    bodyGy  = nil
end

local function FlyTo(pos)
    local hrp = GetHRP()
    if not hrp then return end
    EnableFly()
    if bodyPos then
        bodyPos.Position = pos
    end
    -- wait until close enough
    local t = 0
    while t < 6 do
        task.wait(0.1)
        t = t + 0.1
        local r = GetHRP()
        if not r then return end
        if (r.Position - pos).Magnitude < 8 then break end
    end
end

-- ══════════════════════════════════════════
--  MOB SCANNER
-- ══════════════════════════════════════════
local function GetMobs()
    local r = GetHRP()
    if not r then return {} end
    local list = {}
    for _, m in ipairs(workspace:GetDescendants()) do
        if m:IsA("Model") and m ~= GetChar() then
            local mh = m:FindFirstChildOfClass("Humanoid")
            local mr = m:FindFirstChild("HumanoidRootPart")
            if mh and mr and mh.Health > 0
                and not Players:GetPlayerFromCharacter(m) then
                local d = (r.Position - mr.Position).Magnitude
                if d < CFG.ScanRadius then
                    table.insert(list, {root=mr, hum=mh, dist=d})
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

-- ══════════════════════════════════════════
--  ATTACK
-- ══════════════════════════════════════════
local function M1()
    for i = 1, 6 do
        pcall(function() VIM:SendMouseButtonEvent(0,0,0,true,game,1) end)
        task.wait(0.07)
        pcall(function() VIM:SendMouseButtonEvent(0,0,0,false,game,1) end)
        task.wait(0.07)
    end
end

local function Skills()
    local keys = {
        Enum.KeyCode.Z, Enum.KeyCode.X,
        Enum.KeyCode.C, Enum.KeyCode.V, Enum.KeyCode.F
    }
    for _, k in ipairs(keys) do
        pcall(function() VIM:SendKeyEvent(true,  k, false, game) end)
        task.wait(0.05)
        pcall(function() VIM:SendKeyEvent(false, k, false, game) end)
        task.wait(0.05)
    end
end

